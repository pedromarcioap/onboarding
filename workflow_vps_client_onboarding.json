    {
      "parameters": {
        "method": "POST",
        "url": "=http://SEU_IP_PUBLICO:8080/message/sendText/{{ $json.body.instanceName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SEU_EVOLUTION_APIKEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.body.phone }}"
            },
            {
              "name": "text",
              "value": "=👋 Olá {{ $json.body.clientName }}!\n\nAqui é o seu Assessor Executivo de IA devidamente pareado e operando na sua VPS via Evolution API v2.\n\nSua sessão está ativa e você pode responder a esta mensagem a qualquer momento para validar as respostas da IA diretamente no WhatsApp!"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-send-evolution-whatsapp",
      "name": "Evolution: Disparar Mensagem no Celular",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 900]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"sentTo\": \"{{ $('webhook-send-whatsapp-test').item.json.body.phone }}\",\n  \"instance\": \"{{ $('webhook-send-whatsapp-test').item.json.body.instanceName }}\",\n  \"evolutionResponse\": {{ JSON.stringify($json) }}\n}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type"
              }
            ]
          }
        }
      },
      "id": "respond-send-whatsapp",
      "name": "Responder Confirmação de Disparo",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 900]
    }
